//Integrating AI(chat bot)

import React, { useState } from "react";
import { GoogleGenerativeAI } from "@google/generative-ai";

const App = () => {
  const [searchData, setSearchData] = useState("");
  const [result, setResult] = useState("");

  const genAI = new GoogleGenerativeAI("API__KEY");

  const search = async () => {
    try {
      const model = genAI.getGenerativeModel({
        model: "gemini-2.5-flash",
      });

      const response = await model.generateContent(searchData);
      setResult(response.response.text());
    } catch (err) {
      console.log(err);
    }
  };

  return (
    <div className="min-h-screen bg-gray-100 flex flex-col items-center pt-10">
      <h1 className="text-3xl font-bold mb-6">
        Gemini AI Chat
      </h1>

      <div className="bg-white p-6 rounded-lg shadow-md w-[500px]">
        <input
          type="text"
          value={searchData}
          onChange={(e) => setSearchData(e.target.value)}
          placeholder="Ask anything..."
          className="w-full border border-gray-300 rounded-md px-4 py-2 outline-none focus:border-blue-500"
        />

        <button
          onClick={search}
          className="mt-4 w-full bg-blue-500 text-white py-2 rounded-md hover:bg-blue-600"
        >
          Search
        </button>

        {result && (
          <div className="mt-4 p-3 bg-gray-50 rounded-md">
            <h3 className="font-semibold mb-2">Response:</h3>
            <p>{result}</p>
          </div>
        )}
      </div>
    </div>
  );
};

export default App;

