import React, { useEffect, useState } from 'react'
import './App.css'

const Todo = () => {
    let [input,SetInput] = useState("")
    let [todos,SetTodos] = useState(()=>{
        let data = localStorage.getItem("key")
        if(data){
            return JSON.parse(data)
        }
        return []
    })

    function deleteFunction(index){
        let updatedArray = todos.filter((a,b)=>{
            return index!=b
        })
        SetTodos(updatedArray)
    }

    useEffect(()=>{
    localStorage.setItem("key",JSON.stringify(todos))
    },[todos])

  return (
    <div className='todo'>
        <h1>Todo List</h1>
        <input onChange={(e)=>SetInput(e.target.value)}type="text" placeholder='Enter a task' />
        <button onClick={()=>SetTodos([...todos,input])}>add</button>
        {
            todos.map((a,index)=>{
                return(
                    <div>
                        <h3>{a}</h3>
                        <button onClick={()=>deleteFunction(index)}>Delete</button>
                    </div>
                )
            })
        }
    </div>
  )
}

export default Todo
