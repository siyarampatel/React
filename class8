import React, { useReducer } from 'react'

const UseRed = () => {

    // Initial state
    let initialData = {
        input: "",
        todos: []
    }

    // Reducer handles state updates
    function reducer(state, action) {

        // Update input value
        if (action.type === "set_input") {
            return {
                ...state,
                input: action.payload
            }
        }

        // Add new todo
        else if (action.type === "add_TODO") {
            return {
                input: "",
                todos: [...state.todos, state.input]
            }
        }

        // Return unchanged state
        return state
    }

    // state = current data
    // dispatch = send actions
    let [state, dispatch] = useReducer(reducer, initialData)

    return (
        <div>

            {/* Input field */}
            <input
                value={state.input}
                onChange={(e) =>
                    dispatch({
                        type: "set_input",
                        payload: e.target.value
                    })
                }
            />

            {/* Add todo */}
            <button
                onClick={() =>
                    dispatch({ type: "add_TODO" })
                }
            >
                add
            </button>

            {/* Render todos */}
            {
                state.todos.map((a, index) => {
                    return (
                        <h2 key={index}>{a}</h2>
                    )
                })
            }

        </div>
    )
}

export default UseRed

dispatch sends actions
reducer handles actions
React updates UI from new state
