import React, { useEffect, useState } from 'react'
const App = () => {
  let [count,SetCount] = useState(0);
  let [city,SetCity] = useState("Jodhpur")

  useEffect(()=>{
  console.log("hello");
  },[city])

  return (
    <div>
      <h2>{count}</h2>
      <h1>{city}</h1>
      <button onClick={()=>SetCount(count+1)}>click</button>
      <button onClick={()=>SetCity("Delhi")}>Change City</button>
    </div>
  )
}

export default App

