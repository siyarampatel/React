--normal variable is in state that is static and use state helps in rerendring that is dynamic-----
--if using usestate in parent file then child also rerender(which can be problem)---

import React, { useState } from 'react'
import Home from './Home'

const App = () => {
  let [count,SetCount] = useState(0)
  function fun(){
    SetCount(count+1)
  }
  return (
    <div>
      <h1>{count}</h1>
      <button onClick={fun}>Click</button>
      <Home/>
      </div>
  )
}

export default App

