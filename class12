import React, { useState } from 'react'

function useCounter(data=0) {
    let[count,SetCount] = useState(data)
    function inc(){
        SetCount(count+1)
    }
    function dec(){
        SetCount(count-1)
    }
    function reset(){
        SetCount(0)
    }
    return {count,inc,dec,reset}
}

export default useCounter

