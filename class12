use memo -> repeated calculations are stored beforehand so that the time consuptions can be reduced for calculation in every render.
import React, { useMemo } from 'react'
import useCounter from './useCounter'

const App = () => {
  let {count,inc,dec,reset} = useCounter(0)

  let total = useMemo(()=>{
    let res = 0;
    for (let i=0; i<100000; i++){
      res+=i;
    }
    return res
  },[])

  return (
    <div>
      <h1>{total}</h1>
      <h4>{count}</h4>
      <button onClick={inc}>++</button>
      <button onClick={dec}>--</button>
      <button onClick={reset}>reset</button>
    </div>
  )
}
