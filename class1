import React from 'react'

const App = () => {
  return (
    <div>
      <h2>hello</h2>

      {/* normal text */}
      <h2>5+5</h2>

      {/* JavaScript expression */}
      <h2>{5 + 5}</h2>
    </div>
  )
}

export default App


// React components can be written in two ways
// 1. Functional component
