// Functional components are mostly used nowadays


// Normal variables do not update the UI dynamically

const App = () => {

  let count = 0

  function func() {
    count++
    console.log(count)
  }

  return (
    <div>
      <h1>{count}</h1>
      <button onClick={func}>click</button>
    </div>
  )
}

export default App


// Here count changes internally,
// but React does not re-render the component,
// so UI does not update


// useState is used for dynamic UI updates

import { useState } from "react"

const App = () => {

  let [count, setCount] = useState(0)

  function func() {
    setCount(count + 1)
  }

  return (
    <div>
      <h1>{count}</h1>
      <button onClick={func}>click</button>
    </div>
  )
}

export default App


// useState stores state values

// setCount updates the state

// when state changes,
// React re-renders the component automatically

// the page is not fully reloaded
// only the UI gets updated


import { useState } from "react"

const App = () => {
  
  let[count,SetCount] = useState(0)
  function func(){
    SetCount(count+1)
  }
  function func1(){
    SetCount(count-1)
  }
  return (
    <div>
      <h1>{count}</h1>
      <button onClick={func}>Increment</button>
      <button onClick={func1}>Decrement</button>

    </div>
  )
}



